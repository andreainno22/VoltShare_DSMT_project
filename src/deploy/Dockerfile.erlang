# One image for every Erlang node: station and coordinator differ only by
# the application they start and by their environment. Build context is
# `src/`, so both `erlang/` and `deploy/` are visible.

# The tag must stay aligned with the OTP installed on the developers' machines
# (29.0.5) and with rebar.config's minimum_otp_vsn: same major, same bytecode,
# one distribution protocol.
#
# Debian, not alpine: the official alpine/amd64 build lags behind (stuck at
# 29.0.2 — the 29.0.5-alpine tag only ships 386/arm variants, and Docker
# silently picks the 32-bit one on amd64 hosts). The Debian image is the one
# that gives BOTH the exact pinned version and the native architecture.
FROM erlang:29.0.5 AS build

WORKDIR /build
# The lock travels with the config: without it the build inside the image
# re-resolves the dependency versions and can ship a different cowboy
# than the one tested on the developers' machines.
COPY erlang/rebar.config erlang/rebar.lock ./
COPY erlang/apps ./apps

# `cp -rL` dereferences, and that matters: on Linux rebar3 links the umbrella
# applications into _build instead of copying them. A plain `COPY --from` would
# carry those links into an image where /build does not exist, leaving `-pa
# /app/lib/*/ebin` pointing at nothing and the node dying on boot with a
# "no such file or directory" for the .app. Dereferencing here costs nothing
# and makes the result independent of how rebar3 lays out _build.
RUN rebar3 compile \
    && mkdir -p /out \
    && cp -rL _build/default/lib /out/lib

FROM erlang:29.0.5

WORKDIR /app
COPY --from=build /out/lib /app/lib
COPY deploy/start-node.sh /app/start-node.sh
RUN chmod +x /app/start-node.sh

# Short names (-sname) are enough: on a compose network every container
# resolves the others by service name. Long names (-name) would demand a
# FQDN and buy nothing here.
ENV ERLANG_COOKIE=voltshare \
    NODE_SNAME=vs \
    ERL_APP=vs_station

ENTRYPOINT ["/app/start-node.sh"]
