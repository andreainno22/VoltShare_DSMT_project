%% VoltShare — umbrella project
%%
%% M0 had NO external dependencies on purpose. M1 step 3 (the driver
%% channel) brings the first three, and with them `rebar.lock', which is
%% committed: two machines and the container must resolve the same
%% versions, which is the same reason OTP is pinned below.
%%
%%   {cowboy, "2.18.0"}   driver WebSocket listener (A) — pulls ranch+cowlib
%%   {jsx,    "3.1.0"}    JSON codec on the driver wire (A)
%%   {jose,   "1.11.12"}  JWT verification, named by contracts/jwt.md (A)
%%   {mysql,  "1.8.0"}    sessions INSERT from vs_station_db (A) — M2 step 3
%%
%% Versions are the newest on hex that compile on OTP 29.0.5, checked with
%% `rebar3 pkgs' rather than copied from the design note; the charge point
%% channel of M2 reuses the same cowboy listener stack.
%%
%% OTP 29 on both developers' machines and in the container image, so that a
%% .beam built here is the same one the node runs and the distribution
%% protocol never has two majors to reconcile. Declared, not just agreed:
%% rebar3 refuses to build on an older release rather than failing later.
{minimum_otp_vsn, "29"}.

{erl_opts, [debug_info, warnings_as_errors]}.

%% `warnings_as_errors' above was meant as a rule for OUR code that had to be
%% dropped for the dependencies, where it is not ours to enforce: jose still
%% uses the `catch Expr' form that OTP 29 deprecates, and the build dies on a
%% warning about somebody else's source.
%%
%% WARNING — this line does more than that, and the comment that used to sit
%% here claimed otherwise ("dropped for the deps only — never for apps/").
%% Measured 02/09: the two-element `{del, Options}' form carries no application
%% name, so it applies to EVERY application, `apps/' included. An unused
%% function and an unused variable added to apps/vs_common/src/vs_time.erl both
%% warn and `rebar3 compile' still exits 0. So `warnings_as_errors' is NOT in
%% force on our own code today, and has not been for as long as this line has
%% existed.
%%
%% Left as it is on purpose: restoring the severity on `apps/' changes the
%% build of the whole tree at once and any warning tolerated until now becomes
%% a broken build. It needs its own pair, with a clean run first. Recorded in
%% scelte_di_progetto.md §27.7.
{overrides, [{del, [{erl_opts, [warnings_as_errors]}]}]}.

{deps, [{cowboy, "2.18.0"}, {jsx, "3.1.0"}, {jose, "1.11.12"},
         {mysql, "1.8.0"}]}.

{project_app_dirs, ["apps/*"]}.

{shell, [{apps, [vs_station]}]}.

{dist_node, [{setcookie, voltshare}, {sname, vs}]}.

{profiles, [
    {test, [{erl_opts, [debug_info, nowarn_export_all]}]}
]}.
